// Import Google Fonts
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@700;900&display=swap')

// ====================================
// NAVBAR - Beautiful & Modern
// ====================================
.navbar
  background rgba(255, 255, 255, 0.98) !important
  backdrop-filter blur(20px)
  box-shadow 0 2px 30px rgba(0,0,0,0.08) !important
  border-bottom 1px solid rgba(102, 126, 234, 0.1)
  height 70px
  
  .site-name
    font-weight 800 !important
    font-size 1.5rem !important
    background linear-gradient(135deg, #667eea 0%, #764ba2 100%)
    -webkit-background-clip text
    -webkit-text-fill-color transparent
    letter-spacing -0.5px
    transition all 0.3s ease
    
    &:hover
      transform scale(1.05)
  
  .nav-links
    a.nav-link
      font-weight 600
      color #334155 !important
      font-size 1rem
      margin 0 1rem
      padding 0.5rem 1rem
      border-radius 8px
      transition all 0.3s ease
      position relative
      
      &::after
        content ''
        position absolute
        bottom 0
        left 50%
        transform translateX(-50%)
        width 0
        height 2px
        background linear-gradient(135deg, #667eea 0%, #764ba2 100%)
        transition width 0.3s ease
      
      &:hover
        color #667eea !important
        background rgba(102, 126, 234, 0.08)
        
        &::after
          width 80%
      
      &.router-link-active
        color #667eea !important
        background rgba(102, 126, 234, 0.12)

// ====================================
// HERO SECTION - Stunning Homepage
// ====================================
.home .hero
  background linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important
  padding 120px 2rem !important
  border-radius 0 !important
  position relative
  overflow hidden
  
  &::before
    content ''
    position absolute
    top -50%
    left -50%
    width 200%
    height 200%
    background radial-gradient(circle, rgba(255,255,255,0.1) 1px, transparent 1px)
    background-size 50px 50px
    animation moveBackground 20s linear infinite
    pointer-events none
  
  img
    max-width 350px !important
    max-height 350px !important
    width 100% !important
    height auto !important
    border-radius 50% !important
    border 6px solid rgba(255,255,255,0.3) !important
    box-shadow 0 20px 60px rgba(0,0,0,0.3) !important
    object-fit cover !important
  
  h1
    font-family 'Playfair Display', serif !important
    font-size 4rem !important
    color white !important
    font-weight 900 !important
    text-shadow 0 4px 20px rgba(0,0,0,0.2)
    margin 2rem 0 1rem !important
  
  .description
    font-size 1.5rem !important
    color rgba(255,255,255,0.95) !important
    font-weight 300 !important
    margin-bottom 2.5rem !important
  
  .action-button
    padding 16px 48px !important
    font-size 1.1rem !important
    font-weight 600 !important
    background white !important
    color #667eea !important
    border-radius 50px !important
    box-shadow 0 10px 40px rgba(0,0,0,0.2) !important
    transition all 0.3s ease !important
    
    &:hover
      transform translateY(-5px) !important
      box-shadow 0 15px 50px rgba(0,0,0,0.3) !important

@keyframes moveBackground
  0%
    transform translate(0, 0)
  100%
    transform translate(50px, 50px)

// ====================================
// FEATURES SECTION - Beautiful Cards
// ====================================
.home .features
  max-width 1200px
  margin 80px auto
  padding 0 2rem
  display grid
  grid-template-columns repeat(auto-fit, minmax(280px, 1fr))
  gap 30px

.home .feature
  background white
  padding 50px 35px
  border-radius 20px
  box-shadow 0 10px 40px rgba(0,0,0,0.08)
  transition all 0.4s ease
  position relative
  overflow hidden
  text-align center
  
  &::before
    content ''
    position absolute
    top 0
    left 0
    width 100%
    height 5px
    background linear-gradient(135deg, #667eea 0%, #764ba2 100%)
    transform scaleX(0)
    transition transform 0.4s ease
  
  &:hover
    transform translateY(-15px) scale(1.02)
    box-shadow 0 20px 60px rgba(102, 126, 234, 0.25)
    
    &::before
      transform scaleX(1)
  
  h2
    font-size 2.2rem !important
    font-weight 700 !important
    background linear-gradient(135deg, #667eea 0%, #764ba2 100%)
    -webkit-background-clip text
    -webkit-text-fill-color transparent
    margin-bottom 1.5rem !important
    border none !important
    padding 0 !important
    line-height 1.3
  
  p
    font-size 1.1rem !important
    line-height 1.8 !important
    color #64748b !important
    margin 0 !important

// ====================================
// HOMEPAGE CONTENT - Centered Sections
// ====================================
.home .theme-default-content
  max-width 900px
  margin 0 auto
  padding 4rem 2rem
  text-align center
  
  // Section styling
  > div
    margin 4rem 0
    padding 3rem 2rem
    background white
    border-radius 20px
    box-shadow 0 10px 40px rgba(0,0,0,0.08)
    transition all 0.3s ease
    
    &:hover
      box-shadow 0 15px 50px rgba(102, 126, 234, 0.15)
  
  h2
    font-size 2.5rem !important
    font-weight 700 !important
    background linear-gradient(135deg, #667eea 0%, #764ba2 100%)
    -webkit-background-clip text
    -webkit-text-fill-color transparent
    margin-bottom 2rem !important
    text-align center
    border none !important
    padding 0 !important
  
  h3
    font-size 1.5rem !important
    font-weight 600 !important
    color #8b5cf6 !important
    margin 2rem 0 1rem !important
    text-align center
  
  p
    font-size 1.15rem !important
    line-height 1.9 !important
    color #64748b !important
    margin-bottom 1.5rem !important
    text-align center
  
  strong
    color #667eea !important
    font-weight 600 !important
  
  // Lists centered
  ul
    list-style none !important
    padding 0 !important
    text-align center !important
    
    li
      display inline-block !important
      margin 0.5rem 1rem !important
      padding-left 0 !important
      font-size 1.1rem !important
      color #64748b !important
      
      &::before
        display none !important
  
  // Links
  a
    color #667eea !important
    font-weight 500 !important
    text-decoration none !important
    transition all 0.3s ease !important
    
    &:hover
      color #764ba2 !important
  
  // Horizontal dividers
  hr
    border none !important
    height 2px !important
    background linear-gradient(90deg, transparent, #667eea, transparent) !important
    margin 4rem 0 !important

// ====================================
// ABOUT PAGE & CONTENT STYLING
// ====================================
.theme-default-content:not(.custom)
  max-width 850px
  margin 0 auto
  padding 4rem 2rem
  font-family 'Inter', sans-serif
  
  h1
    font-size 3.5rem
    font-weight 800
    text-align center
    background linear-gradient(135deg, #667eea 0%, #764ba2 100%)
    -webkit-background-clip text
    -webkit-text-fill-color transparent
    margin-bottom 3rem
    letter-spacing -1px
  
  h2
    font-size 2rem
    font-weight 700
    color #667eea
    text-align center
    margin-top 3rem
    margin-bottom 1.5rem
    padding-bottom 0.8rem
    border-bottom 3px solid
    border-image linear-gradient(135deg, #667eea 0%, #764ba2 100%) 1
    position relative
    
    &::after
      content ''
      position absolute
      bottom -3px
      left 50%
      transform translateX(-50%)
      width 60px
      height 3px
      background linear-gradient(135deg, #667eea 0%, #764ba2 100%)
  
  h3
    font-size 1.5rem
    font-weight 600
    color #8b5cf6
    text-align center
    margin-top 2rem
  
  p
    font-size 1.15rem
    line-height 1.9
    color #64748b
    text-align center
    margin-bottom 1.8rem
  
  strong
    color #667eea
    font-weight 600
  
  a
    color #667eea
    font-weight 500
    text-decoration none
    position relative
    transition all 0.3s ease
    
    &::after
      content ''
      position absolute
      bottom -2px
      left 0
      width 0
      height 2px
      background linear-gradient(135deg, #667eea 0%, #764ba2 100%)
      transition width 0.3s ease
    
    &:hover
      color #764ba2
      
      &::after
        width 100%
  
  ul
    list-style none
    padding 0
    text-align center
    
    li
      padding-left 2rem
      position relative
      margin-bottom 1rem
      font-size 1.1rem
      line-height 1.8
      color #64748b
      text-align left
      display inline-block
      
      &::before
        content '▸'
        position absolute
        left 0
        color #667eea
        font-weight bold
        font-size 1.2rem
  
  hr
    border none
    height 2px
    background linear-gradient(90deg, transparent, #667eea, transparent)
    margin 3rem 0
  
  blockquote
    border-left 4px solid #667eea
    background linear-gradient(135deg, #f5f7fa 0%, #c3cfe215 100%)
    padding 1.5rem 2rem
    margin 2rem 0
    border-radius 8px
    font-style italic
    color #334155
    text-align center

// ====================================
// FOOTER - Stylish
// ====================================
.home .footer
  padding 3rem 2rem !important
  background linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important
  color white !important
  text-align center !important
  font-size 1.1rem !important
  border-top none !important
  margin-top 80px !important
  font-weight 500

.page .footer
  padding 2rem !important
  background linear-gradient(135deg, #667eea 0%, #764ba2 100%) !important
  color white !important
  text-align center !important
  margin-top 60px !important

// ====================================
// SCROLLBAR
// ====================================
::-webkit-scrollbar
  width 12px

::-webkit-scrollbar-track
  background #f8fafc

::-webkit-scrollbar-thumb
  background linear-gradient(135deg, #667eea 0%, #764ba2 100%)
  border-radius 10px
  
  &:hover
    background linear-gradient(135deg, #764ba2 0%, #667eea 100%)

// Selection color
::selection
  background #667eea
  color white

// ====================================
// RESPONSIVE DESIGN
// ====================================
@media (max-width: 960px)
  .navbar
    height 60px
    
    .site-name
      font-size 1.3rem !important
    
    .nav-links a.nav-link
      margin 0 0.5rem
      font-size 0.95rem
  
  .home .hero
    padding 80px 1.5rem !important
    
    img
      max-width 250px !important
      max-height 250px !important
    
    h1
      font-size 3rem !important
    
    .description
      font-size 1.3rem !important
  
  .home .features
    grid-template-columns repeat(auto-fit, minmax(250px, 1fr))
    gap 25px
    margin 60px auto
  
  .home .feature
    padding 40px 30px
    
    h2
      font-size 1.9rem !important
    
    p
      font-size 1.05rem !important
  
  .theme-default-content
    padding 3rem 1.5rem
    
    h1
      font-size 2.8rem

@media (max-width: 719px)
  .navbar
    .site-name
      font-size 1.2rem !important
    
    .nav-links a.nav-link
      margin 0 0.3rem
      padding 0.4rem 0.8rem
      font-size 0.9rem
  
  .home .hero
    padding 60px 1rem !important
    
    img
      max-width 200px !important
      max-height 200px !important
    
    h1
      font-size 2.5rem !important
    
    .description
      font-size 1.2rem !important
    
    .action-button
      padding 14px 36px !important
      font-size 1rem !important
  
  .home .features
    grid-template-columns 1fr
    gap 20px
    margin 40px auto
    padding 0 1rem
  
  .home .feature
    padding 35px 25px
    
    h2
      font-size 1.7rem !important
    
    p
      font-size 1rem !important
  
  .home .theme-default-content > div
    padding 2rem 1rem
  
  .theme-default-content
    padding 2rem 1rem
    
    h1
      font-size 2.2rem
    
    h2
      font-size 1.6rem
    
    p
      font-size 1.05rem